{
  "name": "scientia-backend",
  "version": "1.0.0",
  "description": "API do Scientia com autenticacao e autorizacao via JWT",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --env-file=.env.test --test",
    "coverage": "c8 node --env-file=.env.test --test",
    "verificar": "node --env-file=.env.test -e \"import('./src/app.js').then(({ criarApp }) => criarApp())\""
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "src/tests/**"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "reports-dir": "coverage",
    "check-coverage": true,
    "statements": 70,
    "branches": 80
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "supertest": "^7.2.2"
  }
}
